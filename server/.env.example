# Local Vision debug configuration. Never put a real API key in this file.
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_VISION_MODEL_PRIMARY=glm-4.6v
ZHIPU_VISION_MODEL_FALLBACK=glm-4.6v-flash

# When ZHIPU_API_KEY is unset, macOS reads the Debug Key from this Keychain item:
#   service: slow-walk-server.zhipu.debug
#   account: ZHIPU_API_KEY
# Add or update it interactively (the final -w prompts without echoing the key):
# security add-generic-password -U -a ZHIPU_API_KEY -s slow-walk-server.zhipu.debug -w
